rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's document under `users/{uid}` may be read or written only
    // by an authenticated user whose uid matches the document id.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Keep other collections closed by default; add rules for them as needed.
  }
}
